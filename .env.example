# Optional: place the local DSH runtime state outside the repository.
# LWB_DSH_HOME=./lwb/local/dsh-home

# Optional: use a Bailian workspace-specific API base for both voice cloning and synthesis.
# The default is https://dashscope.aliyuncs.com/api/v1.
# LWB_SPOKEN_VIDEO_BAILIAN_BASE_URL=https://<workspace-id>.cn-beijing.maas.aliyuncs.com/api/v1

# Optional: reuse a locally installed Chrome/Chromium for Remotion rendering.
# Export this in the launching shell (the launcher does not auto-load .env).
# LWB_REMOTION_BROWSER_EXECUTABLE=/absolute/path/to/chrome
